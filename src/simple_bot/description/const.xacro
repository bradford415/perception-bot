<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Constant parameters -->
    <xacro:property name="robot_name" value="diff_bot"/>
    <xacro:property name="PI" value="3.1415926535897931" />
    <xacro:property name="chassis_length" value="1.0"/>
    <xacro:property name="chassis_width" value="1.0"/>
    <xacro:property name="chassis_height" value="0.25"/>
    <xacro:property name="wheel_radius" value="0.25"/>
    <xacro:property name="wheel_thickness" value="0.25"/>
    <xacro:property name="caster_wheel_radius" value="${wheel_radius - chassis_height/2}"/>
    <xacro:property name="chassis_mass" value="1.0"/>
    <xacro:property name="left_wheel_mass" value="0.1"/>
    <xacro:property name="right_wheel_mass" value="0.1"/>
    <xacro:property name="caster_wheel_mass" value="0.1"/>

    <xacro:property name="lidar_height" value="0.2"/>
    <xacro:property name="lidar_radius" value="0.2"/>
    <xacro:property name="lidar_mass" value="0.1"/>

    <xacro:property name="camera_height" value="0.1"/>
    <xacro:property name="camera_width" value="0.1"/>
    <xacro:property name="camera_depth" value="0.1"/>
    <xacro:property name="camera_mass" value="0.2"/>



</robot>