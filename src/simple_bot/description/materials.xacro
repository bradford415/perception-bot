<?xml version="1.0"?>
<robot>
    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="red">
    	<color rgba="1.0 0.0 0.0 1.0" />
    </material>

    <material name="purple">
        <color rgba="0.502 0 0.502 1"/>
    </material>

</robot>