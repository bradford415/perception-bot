<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    This document was autogenerated by xacro from robot.xacro                    | -->
<!-- |    EDITING THIS FILE BY HAND IS NOT RECOMMENDED                                 | -->
<!-- =================================================================================== -->
<robot name="robot">
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="orange">
    <color rgba="1 0.3 0.1 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.2 1 1"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>
  <material name="purple">
    <color rgba="0.502 0 0.502 1"/>
  </material>
  <!--
    Specific Documentation:
    - https://robotics.stackexchange.com/questions/103881/gazebo-plugin-location-and-documentation
    - https://medium.com/@bytesrobotics/a-review-of-the-ros2-urdf-gazebo-sensor-91e947c633d7
    -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- Wheels -->
      <right_joint>chassis_link_2_rwheel</right_joint>
      <left_joint>chassis_link_2_lwheel</left_joint>
      <!-- Kinematics -->
      <wheel_separation>1.25</wheel_separation>
      <wheel_radius>0.25</wheel_radius>
      <!-- Limits -->
      <max_linear_acceleration>10</max_linear_acceleration>
      <!-- Output -->
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <topic>cmd_vel</topic>
    </plugin>
    <!-- Publishes joint informaition in gazebo topics-->
    <!-- TODO: Create joint state topics dependent on robot name s.t. can launch multiple robots -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>chassis_link_2_rwheel</joint_name>
      <joint_name>chassis_link_2_lwheel</joint_name>
    </plugin>
    <!-- Name is the plugin name and filename is the library name -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>ground_truth_odom</odom_topic>
    </plugin>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <enable_metrics>true</enable_metrics>
      <!--<gz_frame_id>imu_link</gz_frame_id> -->
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
  <gazebo reference="lidar_link">
    <!-- Lidar Sensor Definition -->
    <sensor name="laser" type="gpu_lidar">
      <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>1</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <gz_frame_id>lidar_link</gz_frame_id>
      <!-- Need this s.t. header is filled similarly to
            how ros2 interprets-->
      <ray>
        <scan>
          <horizontal>
            <samples>640</samples>
            <resolution>1</resolution>
            <min_angle>-3.1415</min_angle>
            <max_angle>3.1415</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>0.01</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
  <gazebo reference="lwheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rwheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="caster_wheel">
    <mu1>0.000001</mu1>
    <mu2>0.000001</mu2>
  </gazebo>
  <!-- Gazebo specific tags such as friction-->
  <!-- TODO:
    - Restructure link structure s.t. has chassis. Follow  https://www.youtube.com/watch?v=BcjHyhV0kIs
    -->
  <link name="base_link"/>
  <joint name="base_2_chassis" type="fixed">
    <origin rpy="0 0 0" xyz="0.5 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="chassis_link"/>
  </joint>
  <link name="chassis_link">
    <visual>
      <geometry>
        <box size="1.0 1.0 0.25"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 1.0 0.25"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.08854166666666666" ixy="0.0" ixz="0.0" iyy="0.08854166666666666" iyz="0.0" izz="0.16666666666666666"/>
    </inertial>
    <gazebo reference="chassis">
      <material>Gazebo/White</material>
    </gazebo>
  </link>
  <!-- Left Wheel -->
  <joint name="chassis_link_2_lwheel" type="continuous">
    <origin rpy="1.5707963267948966 0 3.141592653589793" xyz="-0.5 0.625 0"/>
    <parent link="chassis_link"/>
    <child link="lwheel"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
    <limits effort="100" velocity="10.0"/>
  </joint>
  <link name="lwheel">
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.25"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.25"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0020833333333333333" ixy="0" ixz="0.0" iyy="0.0020833333333333333" iyz="0.0" izz="0.003125"/>
    </inertial>
    <gazebo reference="chassis">
      <material>Gazebo/Red</material>
    </gazebo>
  </link>
  <!-- Right Wheel -->
  <!-- TODO: Ideally want yaw to be 0 so that in HW->SW more symmetricalfor wheel joints-->
  <joint name="chassis_link_2_rwheel" type="continuous">
    <origin rpy="1.5707963267948966 0 3.141592653589793" xyz="-0.5 -0.625 0"/>
    <parent link="chassis_link"/>
    <child link="rwheel"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
    <limits effort="100" velocity="10.0"/>
  </joint>
  <link name="rwheel">
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.25"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.25"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0020833333333333333" ixy="0" ixz="0.0" iyy="0.0020833333333333333" iyz="0.0" izz="0.003125"/>
    </inertial>
    <gazebo reference="chassis">
      <material>Gazebo/Red</material>
    </gazebo>
  </link>
  <!-- Passive Front Caster Wheel that is frictionless-->
  <joint name="chassis_2_caster_wheel" type="fixed">
    <origin rpy="0 0 0" xyz="0.375 0 -0.125"/>
    <parent link="chassis_link"/>
    <child link="caster_wheel"/>
  </joint>
  <gazebo reference="caster_wheel">
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>
  <link name="caster_wheel">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.125"/>
      </geometry>
      <gazebo reference="caster_wheel">
        <material>Gazebo/White</material>
      </gazebo>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.125"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0006250000000000001" ixy="0.0" ixz="0.0" iyy="0.0006250000000000001" iyz="0.0" izz="0.0006250000000000001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="imu_link"/>
  </joint>
  <gazebo reference="imu_link">
    <!-- TODO: Remove gazebo reference from main xacro files when transitioning to different simulators-->
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>
  <link name="imu_link"/>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 0.225"/>
    <parent link="chassis_link"/>
    <child link="lidar_link"/>
  </joint>
  <gazebo reference="lidar_link">
    <!-- TODO: Remove gazebo reference from main xacro files when transitioning to different simulators-->
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.2"/>
      </geometry>
      <material name="purple"/>
      <gazebo reference="caster_wheel">
        <material>Gazebo/White</material>
      </gazebo>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.2" radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0013333333333333335" ixy="0" ixz="0.0" iyy="0.0013333333333333335" iyz="0.0" izz="0.0020000000000000005"/>
    </inertial>
  </link>
  <!-- TODO: Do Camera later-->
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.55 0 0"/>
    <parent link="chassis_link"/>
    <child link="camera_link"/>
  </joint>
  <gazebo reference="camera_link">
    <!-- TODO: Remove gazebo reference from main xacro files when transitioning to different simulators-->
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0003333333333333334" ixy="0.0" ixz="0.0" iyy="0.0003333333333333334" iyz="0.0" izz="0.0003333333333333334"/>
    </inertial>
    <gazebo reference="chassis">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>
</robot>
